*.log
logs/
wandb/
runs/
tensorboard/
.runtime/
.rt/

# ─────────────────────────────────────────────────────────────────────
# Training data + run artifacts (machine-local; do not commit)
# ─────────────────────────────────────────────────────────────────────
# Anchor at repo root only — un-anchored ``data/`` matches any nested
# ``data/`` directory, including the Python package ``thinkstream/data/``
# (which silently swallowed thinkstream/data/schema.py during ``git add -A``).
/data/
# Safety belt: even if a future un-anchored rule sneaks back in, never
# ignore the thinkstream package's data submodule.
!thinkstream/data/
!thinkstream/data/**
thinkstream/data/**/__pycache__/
thinkstream/data/**/*.py[cod]
outputs/
output/
pretrained/
checkpoints/
ckpts/
*.pt
*.bin
*.safetensors
batch*_frames.tar.gz

# ─────────────────────────────────────────────────────────────────────
# Vendored reference projects (cloned for code reuse; not part of source)
# Code we adapted lives inside thinkstream/ directly. The customized Verl
# runtime is vendored in ./verl/ and tracked as part of this repository so RL
# does not depend on an external checkout.
# ─────────────────────────────────────────────────────────────────────
DeepEyes/
IterResearch/
LLaMA-Factory/
MemAgent/
Qwen-Agent/
Qwen3/
Qwen3-VL/
ReMemR1/
streaming-vlm/
Streamo/
Think_While_Watching/
VST/
ThinkStream-CASIA/

# ─────────────────────────────────────────────────────────────────────
# Workspace artifacts (moved to ../thinkstream-workspace/)
# Re-listed here so accidental re-creation in the working tree gets ignored.
# ─────────────────────────────────────────────────────────────────────
paper/
slides/
skills/
evidence/
ablation_results/
references/
recipe/

